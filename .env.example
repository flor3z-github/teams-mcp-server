# HTTP 서버 포트 (기본: 3978)
TEAMS_PORT=3978

# 바인딩 주소 (기본: 127.0.0.1 = 로컬 전용)
# 원격 접속 / Docker에서는 0.0.0.0 필요
# TEAMS_HOST=0.0.0.0

# HTTPS 활성화 (cert/key 둘 다 지정해야 함, 하나만 지정하면 기동 실패)
# TEAMS_TLS_CERT=/path/to/fullchain.pem
# TEAMS_TLS_KEY=/path/to/privkey.pem

# 외부 접근 URL (리버스 프록시 뒤에서 실행 시 지정)
# 미지정 시 {http|https}://localhost:{port} 로 자동 결정됨
# 설정하면 X-Forwarded-* 헤더를 신뢰한다 (trust proxy)
# TEAMS_BASE_URL=https://teams-mcp.example.com

# HTTP + 비-localhost URL 사용 시 MCP SDK 검증 우회
# TEAMS_TLS_* 또는 https TEAMS_BASE_URL을 쓰면 불필요
# MCP_DANGEROUSLY_ALLOW_INSECURE_ISSUER_URL=true

# State 디렉토리 (기본: ~/.claude/channels/teams)
# MSAL 토큰 캐시, OAuth 저장소가 이 디렉토리에 저장됨
# TEAMS_STATE_DIR=

# 로깅 레벨 (debug|info|warn|error, 기본: info)
LOG_LEVEL=info
